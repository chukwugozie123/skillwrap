"use client";

import { useState } from "react";

type Props = {
  userMode: "learning" | "exchanging" | "teaching" | null;
  onClose: () => void;
};

export default function AISkillMatchModal({ userMode, onClose }: Props) {
  const [skillToLearn, setSkillToLearn] = useState("");
  const [skillToOffer, setSkillToOffer] = useState("");
  const [loading, setLoading] = useState(false);

  const API_URL = "http://localhost:4000"; // Your backend URL

  const handleSubmit = async () => {
    if (!skillToLearn) {
      alert("Please enter a skill you want to learn");
      return;
    }

    setLoading(true);

    try {
      const res = await fetch(`${API_URL}/api/ai/match-skill`, {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          skillToLearn,
          skillToOffer:
            userMode === "exchanging" ? skillToOffer : undefined,
        }),
      });

      const data = await res.json();

      console.log("AI MATCH RESULTS:", data);
      alert(`Found ${data.totalMatches} potential partners`);
      onClose();
    } catch (err) {
      alert("Failed to find matches");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-50 bg-black/60 flex items-center justify-center px-4">
      <div className="w-full max-w-md bg-[#0f172a] border border-white/20 rounded-3xl p-6 shadow-2xl">
        <h2 className="text-2xl font-bold text-center mb-6 bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
          AI Skill Match
        </h2>

        {/* Skill to learn */}
        <div className="mb-4">
          <label className="text-sm text-white/70">
            Skill you want to learn
          </label>
          <input
            value={skillToLearn}
            onChange={(e) => setSkillToLearn(e.target.value)}
            className="w-full mt-2 px-4 py-3 rounded-xl bg-white/10 border border-white/20
              focus:outline-none focus:ring-4 focus:ring-cyan-500/40"
            placeholder="e.g. UI/UX Design"
          />
        </div>

        {/* Skill to offer (ONLY for exchanging) */}
        {userMode === "exchanging" && (
          <div className="mb-4">
            <label className="text-sm text-white/70">
              Skill you can offer
            </label>
            <input
              value={skillToOffer}
              onChange={(e) => setSkillToOffer(e.target.value)}
              className="w-full mt-2 px-4 py-3 rounded-xl bg-white/10 border border-white/20
                focus:outline-none focus:ring-4 focus:ring-cyan-500/40"
              placeholder="e.g. Frontend Development"
            />
          </div>
        )}

        {/* Actions */}
        <div className="flex gap-3 mt-6">
          <button
            onClick={onClose}
            className="flex-1 py-3 rounded-xl border border-white/20 hover:bg-white/10"
          >
            Cancel
          </button>

          <button
            onClick={handleSubmit}
            disabled={loading}
            className="flex-1 py-3 rounded-xl font-semibold
              bg-gradient-to-r from-cyan-500 to-blue-600
              hover:opacity-90 disabled:opacity-50"
          >
            {loading ? "Finding..." : "Find Matches"}
          </button>
        </div>
      </div>
    </div>
  );
}
